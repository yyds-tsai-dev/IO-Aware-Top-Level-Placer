        <mxCell id="c1" value="&lt;b&gt;Pseudo-point FT (P-E)&lt;/b&gt; &amp;#8212; one movable point per crossing net decides which region the net passes through" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontFamily=Times New Roman;fontSize=16;fontSize=20;" vertex="1" parent="1">
